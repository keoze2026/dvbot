# ── Telegram ────────────────────────────────────────────────────────────────
# From @BotFather.
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to run /stop, /balance, /status
# (and who receive event alerts when NOTIFY_ADMINS=true). Get yours from @userinfobot.
ADMIN_IDS=

# debug | info | warn | error
LOG_LEVEL=info

# ── DV.net ──────────────────────────────────────────────────────────────────
# Host only, no path. DV.net cloud: https://cloud.dv.net (the API key identifies your store)
# Self-hosted: the domain dv-merchant is served from, e.g. https://pay.example.com
DVNET_HOST=

# Project -> advanced settings -> "API key". Sent as the x-api-key header.
DVNET_API_KEY=

# Project -> advanced settings -> "Secret". DV.net signs every webhook with it
# (X-Sign = sha256(body + secret)). Leave blank and the webhook receiver stays
# off: the bot still issues addresses, but nobody is told when money arrives.
DVNET_WEBHOOK_SECRET=

# ── Deposits (/topup) ───────────────────────────────────────────────────────
# Currency IDs to offer, comma-separated, in menu order. Format <CODE>.<Blockchain>:
#   USDT.Tron  USDT.Ethereum  USDT.BNBSmartChain  USDT.Polygon  USDC.Ethereum
#   BTC.Bitcoin  ETH.Ethereum  LTC.Litecoin  TRX.Tron  SOL.Solana  TON.Ton ...
# One entry = no menu, /topup answers with that address directly.
# "all" = every currency enabled on the store (menu shown).
DEPOSIT_CURRENCIES=USDT.Tron

# Max buttons in the currency menu.
DEPOSIT_MENU_LIMIT=10

# reuse  = one permanent wallet per Telegram user; /topup always returns the same address (default)
# unique = a brand-new wallet (new addresses) on every /topup
ADDRESS_MODE=reuse

# ── Invoices (/pay <amount>) ────────────────────────────────────────────────
# Hosted DV.net checkout page for a fixed USD amount.
PAY_ENABLED=true
PAY_MIN_AMOUNT=1
# Optional currency ID to preselect on the checkout page (blank = the payer picks).
PAY_CURRENCY=

# ── Rate limiting (per user) ────────────────────────────────────────────────
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── Webhook receiver ────────────────────────────────────────────────────────
# DV.net POSTs payment events to https://<your-domain><WEBHOOK_PATH>.
# Put the public URL in the project's webhook settings. Reverse-proxy it over
# HTTPS (nginx + certbot) to this port. Adding a random suffix to the path is
# cheap extra cover against scanners; the signature is what actually authenticates.
WEBHOOK_PORT=8080
WEBHOOK_PATH=/dvnet/webhook

# ── Notifications ───────────────────────────────────────────────────────────
# Which events to relay: in = deposits (PaymentNotConfirmed / PaymentReceived /
# PaymentAMLBlocked), out = withdrawals (WithdrawalFromProcessingReceived).
NOTIFY_DIRECTIONS=in,out
# Message the depositor as soon as the payment is seen, before it confirms.
NOTIFY_UNCONFIRMED=true
# Also send every event to ADMIN_IDS on Telegram (works without SMTP).
NOTIFY_ADMINS=true

# ── Email alerts (optional; needs SMTP_HOST and MAIL_TO) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
